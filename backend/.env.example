# Django backend configuration.
# Copy to `.env` and fill in real values:  cp .env.example .env
# Consumed by docker-compose.yml (django service) and mainapp/local_settings.py.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
# 'development' or 'production' make local_settings.py read the vars below.
# Any other value (or unset) falls back to hardcoded local defaults.
DJANGO_ENV=development
DEBUG=1
SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# ---------------------------------------------------------------------------
# Superuser auto-created by backend/entrypoint.sh on container start.
# NOTE: entrypoint.sh DELETES any existing user with this email, then recreates
# it on every boot. Do not reuse a real account here.
# ---------------------------------------------------------------------------
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Database
# DATABASE=postgres makes entrypoint.sh wait for the DB before migrating.
# Must match postgres/.env.
# ---------------------------------------------------------------------------
DATABASE=postgres
DB_ENGINE=django.db.backends.postgresql
DB_DATABASE=predictiondb
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=db
DB_PORT=5432

# ---------------------------------------------------------------------------
# Email (fraud alerts). Gmail requires an App Password, not the account password.
# Read by mainapp/settings.py; DEFAULT_FROM_EMAIL is used by
# transactions/management/commands/ETL_script.py.
# ---------------------------------------------------------------------------
EMAIL_HOST_USER=replace-me@example.com
EMAIL_HOST_PASSWORD=replace-me-app-password
DEFAULT_FROM_EMAIL=replace-me@example.com

# ---------------------------------------------------------------------------
# Redis (Channels layer). 'redis' is the docker-compose service name;
# use 127.0.0.1 when running Redis natively.
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Trained model used by the ETL commands. Defaults to
# <djangoapp>/models/random_forest.pkl -- see that directory's README.
# ---------------------------------------------------------------------------
FRAUD_MODEL_PATH=

# ---------------------------------------------------------------------------
# CORS. Comma-separated allowed origins, applied when DJANGO_ENV is
# development or production. Leave empty to allow all origins (development
# only -- do not ship an empty value).
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
