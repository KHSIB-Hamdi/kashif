# Create React App environment. Copy to `.env` for local development.
# Only variables prefixed REACT_APP_ are exposed to the bundle.
#
# WARNING: everything here is embedded in the JavaScript served to every
# visitor. Never put a long-lived secret in this file.

# Backend REST base URL. Read by src/settings.js (production branch only;
# development hardcodes http://localhost:8000).
REACT_APP_API_SERVER=http://localhost:8000

# WebSocket base URL. Leave unset to use the sensible default: the daphne port
# (ws://localhost:8001) in development, and the page's own origin in production
# where nginx proxies /ws/ to daphne.
REACT_APP_WS_SERVER=

# ---------------------------------------------------------------------------
# Power BI embed (src/views/analytics/PowerBI.js)
# The access token is short-lived and must be minted per session. Embedding a
# user token in the bundle ships it to every browser -- see README >
# Troubleshooting for the recommended backend-token-endpoint approach.
# ---------------------------------------------------------------------------
REACT_APP_POWERBI_REPORT_ID=00000000-0000-0000-0000-000000000000
REACT_APP_POWERBI_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=00000000-0000-0000-0000-000000000000
REACT_APP_POWERBI_ACCESS_TOKEN=replace-me
